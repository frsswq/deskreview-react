{
  "name": "deskreview-react",
  "version": "0.0.0",
  "private": true,
  "description": "This template provides a minimal setup to get React working in Vite with HMR.",
  "keywords": [],
  "homepage": "https://github.com/frsswq/deskreview-react/",
  "bugs": {
    "url": "https://github.com/frsswq/deskreview-react/issues"
  },
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frsswq/deskreview-react.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "optimize:images:blog": "bun src/utils/convertImagesToWebP.js blog",
    "optimize:images:home": "bun src/utils/convertImagesToWebP.js home",
    "optimize:images": "bun src/utils/convertImagesToWebP.js",
    "lint": "oxlint --react-plugin --import-plugin --deny-warnings .",
    "lint:fix": "oxlint --react-plugin --import-plugin --fix .",
    "format": "oxfmt --write package.json index.html 404.html vite.config.ts \"src/**/*.{ts,tsx,css,json}\" \"tsconfig*.json\"",
    "format:check": "oxfmt --check package.json index.html 404.html vite.config.ts \"src/**/*.{ts,tsx,css,json}\" \"tsconfig*.json\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.1.1",
    "@fontsource/eb-garamond": "^5.1.2",
    "@radix-ui/react-icons": "^1.3.2",
    "gray-matter": "^4.0.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "^9.0.3",
    "react-router": "^7.1.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.8.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13"
  },
  "packageManager": "bun@1.3.14"
}
